@model Story
<article class="book-card"><a href="/Story/Details/@Model.Id" class="cover-link" aria-label="Xem @Model.Title"><div class="book-cover tone-@(Model.Id%4)"><span class="cover-author">@Model.Author</span><strong>@Model.Title</strong><span class="cover-rule"></span><span class="genre-label">@Model.Genre</span></div></a><h3><a href="/Story/Details/@Model.Id">@Model.Title</a></h3><div class="book-meta"><span><svg class="icon gold"><use href="#i-star"/></svg> @Model.Rating</span><span>@Model.Views.ToString("N0") lượt đọc</span><span class="status">@Model.Status</span></div></article>
