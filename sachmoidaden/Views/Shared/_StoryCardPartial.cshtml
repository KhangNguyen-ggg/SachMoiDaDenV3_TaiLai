@model Story
<article class="book-card"><a href="/Story/Details/@Model.Id" class="cover-link" aria-label="Xem @Model.Title">@if(Model.HasCover){<div class="book-cover uploaded-cover"><img src="/Story/Cover/@Model.Id" alt="Bìa sách @Model.Title" loading="lazy"/></div>}else{<div class="book-cover no-cover"><strong>@Model.Title</strong><span class="muted">Chưa có ảnh bìa</span></div>}</a><h3><a href="/Story/Details/@Model.Id">@Model.Title</a></h3><div class="book-meta"><span><svg class="icon gold"><use href="#i-star"/></svg> @Model.Rating</span><span>@Model.Views.ToString("N0") lượt đọc</span><span class="status">@Model.Status</span></div></article>
