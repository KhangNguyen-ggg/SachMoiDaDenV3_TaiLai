@model CommentItemViewModel
@{var c=Model.Comment;}
<article id="comment-@c.Id" class="comment @(c.ParentId.HasValue?"comment-reply":"")"><div class="comment-heading"><strong>@c.Author</strong><time datetime="@c.CreatedAt.ToString("o")">@ContentQueries.Vietnam(c.CreatedAt).ToString("dd/MM/yyyy HH:mm")</time></div>@if(c.ParentId.HasValue){<a class="mention" href="#comment-@c.ParentId">@($"@{Model.ReplyAuthor}")</a>}<p class="preserve-lines comment-text" id="comment-body-@c.Id">@c.Text</p><button type="button" class="text-button comment-expand" aria-expanded="false" aria-controls="comment-body-@c.Id" hidden>Xem thêm</button><div class="comment-actions">@if(User.Identity?.IsAuthenticated==true){<button class="text-button" type="button" data-reply-id="@c.Id" data-reply-author="@c.Author">Trả lời</button>}<partial name="_Report" model='@(("comment",c.Id))'/></div></article>
