@model CommentListViewModel
<div class="comments">@foreach(var c in Model.Comments){<partial name="_Comment" model="@(new CommentItemViewModel(c,Model.Comments.FirstOrDefault(x=>x.Id==c.ParentId)?.Author))"/>}
@if(User.Identity?.IsAuthenticated==true){<form class="stack comment-form" asp-controller="Discussion" asp-action="Comment" method="post"><input type="hidden" name="storyId" value="@Model.StoryId"/><input type="hidden" name="chapterId" value="@Model.ChapterId"/><input type="hidden" name="postId" value="@Model.PostId"/><input type="hidden" name="parentId" value=""/><div class="reply-target" hidden><span aria-live="polite"></span> <button class="text-button cancel-reply" type="button">Hủy trả lời</button></div><label for="comment-text">Bình luận của bạn</label><textarea id="comment-text" name="text" rows="4" maxlength="2000" required></textarea><button class="button primary">Đăng bình luận</button></form>}
else{<p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path+Context.Request.QueryString)">Đăng nhập</a> để tham gia thảo luận.</p>}</div>
