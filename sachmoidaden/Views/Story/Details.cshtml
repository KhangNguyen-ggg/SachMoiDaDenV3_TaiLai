@model StoryViewModel
@{ViewData["Title"]=Model.Book.Title;var b=Model.Book;}
<div class="container page story-detail"><a class="back-link" href="/Home/Catalog">← Thư viện</a><div class="book-detail"><div class="detail-cover"><partial name="_StoryCardPartial" model="b"/></div><div class="book-intro"><p class="muted">@b.Genre · @b.Status</p><h1>@b.Title</h1><p class="author">Tác giả: @b.Author</p><p class="description">@b.Description</p><p class="muted">@b.Rating / 5 · @b.Ratings.Count đánh giá · @b.Chapters.Count chương · @b.Views.ToString("N0") lượt xem</p><div class="actions">
@if(b.Chapters.Count>0){<a class="button primary" href="/Story/Read/@b.Id">Bắt đầu đọc</a>}
@if(User.Identity?.IsAuthenticated==true){<form asp-controller="User" asp-action="Save" method="post"><input type="hidden" name="id" value="@b.Id"/><input type="hidden" name="saved" value="@((!Model.Saved).ToString().ToLowerInvariant())"/><button class="button">@(Model.Saved?"Bỏ khỏi tủ sách":"Lưu vào tủ sách")</button></form>}
else{<a class="button" asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Story/Details/@b.Id">Đăng nhập để lưu sách</a>}
</div><partial name="_Report" model='@(("book",b.Id))'/></div></div>
<div class="detail-columns"><div><section class="content-section chapters-panel"><h2>Danh sách chương</h2>@if(b.Chapters.Count==0){<p class="empty">Sách chưa có chương. Hãy quay lại sau.</p>}<ol class="chapter-list">@for(int i=0;i<b.Chapters.Count;i++){<li><a href="/Story/Read/@b.Id?chapter=@b.Chapters[i].Number"><span>Chương @b.Chapters[i].Number. @b.Chapters[i].Title</span><span aria-hidden="true">→</span></a></li>}</ol></section>
<section class="content-section discussion-panel"><h2>Diễn đàn cộng đồng</h2><p>Chia sẻ cảm nhận, trao đổi và khám phá chủ đề theo tag.</p><a class="button" href="/Discussion">Mở diễn đàn</a></section><section class="content-section comments-panel"><h2>Bình luận <span class="count">@Model.Comments.Count</span></h2><partial name="_Comments" model="@(new CommentListViewModel(Model.Comments,b.Id,null))"/>
</section></div><aside class="rating-panel"><h2>Đánh giá sách</h2><p class="rating-number">@b.Rating <span>/ 5</span></p><p class="muted">Từ @b.Ratings.Count người đọc</p>
@if(User.Identity?.IsAuthenticated==true){<form class="stack" asp-controller="Discussion" asp-action="Rate" method="post"><input type="hidden" name="storyId" value="@b.Id"/><label for="rating">Đánh giá của bạn</label><select id="rating" name="value" required><option value="">Chọn số sao</option>@for(int i=1;i<=5;i++){<option value="@i" selected="@(i==Model.MyRating)">@i sao</option>}</select><button class="button">Lưu đánh giá</button></form><p class="hint">Bạn có thể cập nhật đánh giá bất cứ lúc nào.</p>}
</aside></div></div>

<section class="container content-section similar-section"><h2>Truyện tương tự</h2>@if(((List<Story>)ViewBag.Similar).Count==0){<p class="muted">Chưa có truyện công khai cùng thể loại.</p>}<div class="book-grid">@foreach(Story similar in ViewBag.Similar){<partial name="_StoryCardPartial" model="similar"/>}</div></section>
