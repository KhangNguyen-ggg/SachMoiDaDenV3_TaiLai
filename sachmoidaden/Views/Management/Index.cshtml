@model ForumData
@{ViewData["Title"]="Quản lý";string tab=ViewBag.Tab;bool admin=User.IsInRole(Roles.Admin);bool reviewer=admin||User.IsInRole(Roles.Moderator);}
<div class="container page"><div class="page-heading section-heading"><div><h1>Quản lý diễn đàn</h1><p>Nội dung rõ ràng, cộng đồng gắn kết.</p></div>@if(admin||User.IsInRole(Roles.Contributor)){<a class="button primary" href="/Management/Book">Thêm sách</a>}</div>
<nav class="tabs" aria-label="Khu vực quản lý"><a class="@(tab=="books"?"active":"")" href="/Management?tab=books">Sách</a>@if(reviewer){<a class="@(tab=="reports"?"active":"")" href="/Management?tab=reports">Báo cáo (@Model.Reports.Count(r=>!r.Resolved))</a><a class="@(tab=="posts"?"active":"")" href="/Management?tab=posts">Bài viết & bình luận</a>}@if(admin){<a class="@(tab=="genres"?"active":"")" href="/Management?tab=genres">Thể loại</a><a class="@(tab=="users"?"active":"")" href="/Management?tab=users">Tài khoản</a>}</nav>
@if(tab=="books"){
<h2>Sách <span class="count">@Model.Stories.Count</span></h2><p class="muted">@Model.Stories.Count(b=>b.PendingApproval) sách chờ duyệt. Mở “Xem nội dung” để đọc các chương trước khi duyệt.</p><p class="scroll-hint">Trên màn hình nhỏ, vuốt ngang bảng để xem thao tác.</p>
<div class="table-wrap" role="region" aria-label="Danh sách sách" tabindex="0"><table><thead><tr><th>Sách</th><th>Thể loại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var b in Model.Stories){<tr><td><strong>@b.Title</strong><small>@b.Author · @b.Chapters.Count chương</small></td><td>@b.Genre</td><td><span class="state">@(b.PendingApproval?"Chờ duyệt":"Đã duyệt") · @(b.Hidden?"Đang ẩn":"Không bị ẩn")</span></td><td><div class="table-actions"><a href="/Management/Preview/@b.Id">Xem nội dung</a>@if(admin||User.IsInRole(Roles.Contributor)){<a href="/Management/Book/@b.Id">Sửa / thêm chương</a>}@if(reviewer){<form asp-action="Moderate" method="post"><input type="hidden" name="kind" value="book"/><input type="hidden" name="id" value="@b.Id"/>@if(b.PendingApproval){<button class="button small" name="action" value="approve">Duyệt</button>}<button class="button small" name="action" value="@(b.Hidden?"restore":"hide")">@(b.Hidden?"Khôi phục":"Ẩn")</button></form>}</div></td></tr>}
</tbody></table></div>@if(Model.Stories.Count==0){<p class="empty">Bạn chưa đăng sách nào. Chọn “Thêm sách” để bắt đầu.</p>}}
@if(tab=="reports"){
<h2>Báo cáo nội dung</h2>@if(Model.Reports.Count==0){<p class="empty">Chưa có báo cáo cần xử lý.</p>}
@foreach(var r in Model.Reports.OrderBy(r=>r.Resolved).ThenByDescending(r=>r.Id)){<article class="management-entry"><div class="section-heading"><h3>@(r.Kind=="book"?"Sách":r.Kind=="post"?"Bài viết":"Bình luận") #@r.TargetId</h3><span class="state">@(r.Resolved?"Đã xử lý":"Chờ xử lý")</span></div><p class="preserve-lines">@r.TargetTitle</p><p><strong>Lý do:</strong> @r.Reason</p><div class="actions"><a href="@(r.Kind=="book"?$"/Management/Preview/{r.TargetId}":$"/Management?tab=posts#{r.Kind}-{r.TargetId}")">Xem nội dung</a><form asp-action="Moderate" method="post"><input type="hidden" name="kind" value="@r.Kind"/><input type="hidden" name="id" value="@r.TargetId"/><button name="action" value="hide" class="button small">Ẩn nội dung</button><button name="action" value="restore" class="button small">Khôi phục</button></form></div>
@if(r.Resolved){<p><strong>Kết quả:</strong> @r.Resolution</p><p class="muted">Người xử lý #@r.ResolverId · @(r.ResolvedAt.HasValue?ContentQueries.Vietnam(r.ResolvedAt.Value).ToString("dd/MM/yyyy HH:mm"):"")</p>}else{<form asp-action="Resolve" method="post" class="stack"><input type="hidden" name="id" value="@r.Id"/><label for="resolution-@r.Id">Kết quả xử lý</label><textarea id="resolution-@r.Id" name="resolution" required maxlength="1000" rows="2"></textarea><button class="button primary small">Hoàn tất báo cáo</button></form>}</article>}}
@if(tab=="posts"){
<h2>Bài thảo luận</h2>@if(Model.Posts.Count==0){<p class="empty">Chưa có bài thảo luận.</p>}
@foreach(var post in Model.Posts){<article id="post-@post.Id" class="management-entry"><div class="section-heading"><h3>@post.Title</h3><span class="state">@(post.Hidden?"Đang ẩn":"Hiển thị")</span></div><p class="muted">@post.Author · Diễn đàn #@post.Id</p><p class="preserve-lines">@post.Body</p><form asp-action="Moderate" method="post"><input type="hidden" name="kind" value="post"/><input type="hidden" name="id" value="@post.Id"/><button name="action" value="@(post.Hidden?"restore":"hide")" class="button small">@(post.Hidden?"Khôi phục":"Ẩn bài viết")</button></form></article>}
<h2>Bình luận</h2>@foreach(var c in Model.Comments){<article id="comment-@c.Id" class="management-entry"><strong>@c.Author</strong><p class="preserve-lines">@c.Text</p><p class="muted">@ContentQueries.Scope(c) · @(c.Hidden?"Đang ẩn":"Không bị ẩn") · @(ContentQueries.IsPublic(Model,c)?"Công khai":"Chưa công khai do trạng thái nội dung hoặc tổ tiên")</p><form asp-action="Moderate" method="post"><input type="hidden" name="kind" value="comment"/><input type="hidden" name="id" value="@c.Id"/><button name="action" value="@(c.Hidden?"restore":"hide")" class="button small">@(c.Hidden?"Khôi phục":"Ẩn bình luận")</button></form></article>}}
@if(tab=="genres"){
<h2>Thể loại sách</h2><form class="filter-bar" asp-action="Genre" method="post"><div class="field"><label for="new-genre">Tên thể loại mới</label><input id="new-genre" name="name" required maxlength="60"/></div><button class="button primary">Thêm thể loại</button></form>
@foreach(var g in Model.Genres){<div class="genre-row"><form asp-action="RenameGenre" method="post" class="inline-form"><input type="hidden" name="name" value="@g"/><label class="sr-only" for="genre-@Model.Genres.IndexOf(g)">Tên thể loại @g</label><input id="genre-@Model.Genres.IndexOf(g)" name="newName" value="@g" required maxlength="60"/><button class="button small">Đổi tên</button></form><span class="muted">@Model.Stories.Count(b=>b.Genres.Contains(g)) sách</span><form asp-action="DeleteGenre" method="post"><input type="hidden" name="name" value="@g"/><button class="button small" disabled="@(Model.Stories.Any(b=>b.Genres.Contains(g)))">Xóa</button></form></div>}<p class="hint">Chỉ xóa được thể loại chưa có sách. Đổi tên sẽ cập nhật tất cả sách liên quan.</p>}
@if(tab=="users"){
<h2>Tài khoản <span class="count">@Model.Users.Count</span></h2><p class="scroll-hint">Trên màn hình nhỏ, vuốt ngang bảng để xem thao tác.</p><div class="table-wrap" role="region" aria-label="Danh sách tài khoản" tabindex="0"><table><thead><tr><th>Thành viên</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in Model.Users){bool self=u.Id.ToString()==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;<tr><td><strong>@u.Name</strong><small>@u.Email</small></td><td><form asp-action="UserRole" method="post" class="inline-form"><input type="hidden" name="id" value="@u.Id"/><label class="sr-only" for="role-@u.Id">Vai trò của @u.Name</label><select name="role" id="role-@u.Id" disabled="@self">@foreach(var role in Roles.All){<option value="@role" selected="@(role==u.Role)">@Roles.Label(role)</option>}</select><button class="button small" disabled="@self">Lưu</button></form></td><td>@(u.Locked?"Đã khóa":"Hoạt động")</td><td><form asp-action="ToggleUser" method="post"><input type="hidden" name="id" value="@u.Id"/><input type="hidden" name="locked" value="@((!u.Locked).ToString().ToLowerInvariant())"/><button class="button small" disabled="@self">@(u.Locked?"Mở khóa":"Khóa")</button></form></td></tr>}</tbody></table></div><p class="hint">Không thể tự khóa hoặc tự bỏ quyền quản trị. Khi tài khoản bị khóa, phiên đăng nhập hiện tại sẽ kết thúc.</p>}
</div>
