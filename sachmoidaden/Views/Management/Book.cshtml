@model EditBookInput
@{ViewData["Title"]=Model.Id==0?"Thêm sách":"Sửa sách";}
<div class="container page narrow"><a class="back-link" href="/Management">← Quản lý sách</a><h1>@ViewData["Title"]</h1><p class="muted">Nhập thông tin, chọn loại truyện và thêm chương sau khi lưu.</p>
@if(User.IsInRole(Roles.Contributor)){<p class="notice">Sách mới và các thay đổi của bạn sẽ chờ kiểm duyệt trước khi công khai.</p>}
<form asp-action="Book" method="post" class="stack"><div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden"/><label asp-for="Title">Tên sách</label><input asp-for="Title" maxlength="160" required/><label asp-for="Author">Tác giả</label><input asp-for="Author" maxlength="100" required/><fieldset><legend>Thể loại (chọn ít nhất một)</legend><div class="genre-options">@foreach(string g in ViewBag.Genres){<label><input type="checkbox" name="Genres" value="@g" checked="@Model.Genres.Contains(g)"/> @g</label>}</div></fieldset><label asp-for="Kind">Loại truyện</label><select asp-for="Kind"><option value="Text">Truyện chữ</option><option value="Comic">Truyện tranh</option></select><label asp-for="Status">Trạng thái</label><select asp-for="Status"><option>Đang ra</option><option>Hoàn thành</option></select><label asp-for="Description">Giới thiệu sách</label><textarea asp-for="Description" maxlength="3000" required rows="5"></textarea><button class="button primary">Lưu thông tin sách</button></form>
@if(Model.Id!=0){<section class="content-section"><h2>Thêm chương mới</h2><p><a href="/Management/Preview/@Model.Id">Xem các chương hiện có</a></p>@if(Model.Kind==StoryKind.Text){<form asp-action="Chapter" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id"/><label for="chapter-title">Tên chương</label><input id="chapter-title" name="title" maxlength="160" required/><label for="chapter-content">Nội dung chương</label><textarea id="chapter-content" name="content" rows="12" maxlength="100000" required></textarea><button class="button primary">Thêm chương</button></form>}else{<form asp-action="ComicChapter" method="post" enctype="multipart/form-data" class="stack comic-upload"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="order" value="[]"/><label for="comic-title">Tên chương</label><input id="comic-title" name="title" maxlength="160" required/><label for="comic-pages">Ảnh trang truyện</label><input id="comic-pages" type="file" name="pages" accept=".jpg,.jpeg,.png,.webp" multiple required/><div class="upload-add"><button type="button" class="button add-comic-pages">Thêm ảnh</button><input id="comic-more-pages" type="file" accept=".jpg,.jpeg,.png,.webp" multiple hidden aria-label="Chọn ảnh để thêm"/></div><p class="hint">Từ 1–50 ảnh JPG/PNG/WebP; tối đa 5 MiB/ảnh, 50 MiB/chương. Dùng “Thêm ảnh” để nối tiếp, hoặc chọn lại ở ô trên để thay toàn bộ danh sách.</p><p class="upload-status" role="status"></p><div class="upload-preview"></div><button class="button primary">Đăng chương truyện tranh</button></form>}<details class="content-section"><summary>Đăng chương bằng tệp TXT, MD, PDF hoặc ảnh</summary><form asp-action="FileChapter" method="post" enctype="multipart/form-data" class="stack file-upload"><input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="order" value="[]"/><label for="file-title">Tên chương</label><input id="file-title" name="title" maxlength="160" required/><label for="chapter-files">Tệp nội dung</label><input id="chapter-files" type="file" name="uploads" accept=".txt,.md,.pdf,.jpg,.jpeg,.png,.webp" multiple required/><p class="hint">TXT/MD dùng UTF-8, tối đa 2 MiB/tệp; PDF 20 MiB/tệp; ảnh 5 MiB/tệp, tổng ảnh 50 MiB. Tối đa 50 tệp và 100 MiB/chương. Nội dung Markdown hiển thị như văn bản.</p><p class="upload-status" role="status"></p><div class="upload-preview"></div><button class="button primary">Đăng chương bằng tệp</button></form></details></section>}
</div>
