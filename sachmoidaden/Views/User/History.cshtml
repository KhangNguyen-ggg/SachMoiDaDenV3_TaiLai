@model List<Story>
@{ViewData["Title"]="Lịch sử đọc";var history=(Dictionary<int,int>)ViewBag.History;}
<div class="container page"><div class="page-heading"><h1>Lịch sử đọc</h1><p>Tiếp tục từ chương bạn đã mở gần nhất ở mỗi cuốn sách.</p></div>@if(Model.Count==0){<div class="empty"><h2>Chưa có lịch sử đọc</h2><p>Đọc sách khi đăng nhập để lưu lại chương đang đọc.</p><a class="button primary" href="/Home/Catalog">Đến thư viện</a></div>}<div class="book-grid">@foreach(var b in Model){<div><partial name="_StoryCardPartial" model="b"/><a class="button small" href="/Story/Read/@b.Id?chapter=@(b.Chapters.First(c=>c.Id==history[b.Id]).Number)">Đọc tiếp chương @(b.Chapters.First(c=>c.Id==history[b.Id]).Number)</a></div>}</div></div>
