@model HomeViewModel
@using sachmoidaden.Services
@{ViewData["Title"]="Khám phá";var featured=Model.Featured;}
<section class="hero"><div class="container">
@if(featured.Count==0){<h1>Một trang sách, một hành trình.</h1><p>Sách mới sẽ sớm có mặt trong thư viện.</p>}
@for(int i=0;i<featured.Count;i++){var b=featured[i];<div class="hero-slide" hidden="@(i!=0)"><h1>@b.Title</h1><p class="hero-description">@b.Description</p><p class="hero-meta"><svg class="icon gold"><use href="#i-flame"/></svg>@b.Views.ToString("N0") lượt đọc <span>·</span> @b.Genre</p><div class="actions"><a class="button primary" href="/Story/@(b.Chapters.Count>0?"Read":"Details")/@b.Id"><svg class="icon"><use href="#i-book"/></svg>Bắt đầu đọc</a><a class="button" asp-action="Catalog" asp-route-genre="@b.Genres.FirstOrDefault()">Thể loại tương tự <svg class="icon"><use href="#i-arrow"/></svg></a></div></div>}
<div class="hero-dots" aria-label="Chọn sách nổi bật">@for(int i=0;i<featured.Count;i++){<button data-slide="@i" aria-label="Sách nổi bật @(i+1): @featured[i].Title" aria-pressed="@(i==0?"true":"false")"></button>}</div>
</div></section>
<div class="container home-content home-layout"><section class="book-section popular-section"><h2><svg class="icon gold"><use href="#i-flame"/></svg>Đang được đọc nhiều</h2><div class="book-grid home-grid">@foreach(var b in Model.Popular){<partial name="_StoryCardPartial" model="b"/>}</div></section>
<aside class="rank-panel"><h2>Top lượt đọc</h2><p class="muted">Khám phá những truyện đang được đọc trong kỳ.</p><div class="ranking-tabs" aria-label="Kỳ xếp hạng">@foreach(var period in Enum.GetValues<RankingPeriod>()){<button type="button" data-ranking="@period" aria-pressed="@(period==RankingPeriod.Day?"true":"false")" aria-controls="ranking-@period">@(period==RankingPeriod.Day?"Ngày":period==RankingPeriod.Week?"Tuần":"Tháng")</button>}</div>
@foreach(var period in Enum.GetValues<RankingPeriod>()){var ranked=Model.Rankings[period];<div id="ranking-@period" class="ranking-list" hidden="@(period!=RankingPeriod.Day)">@if(ranked.Count==0){<p class="empty">Chưa có lượt đọc trong kỳ này.<br/>Mở một chương để bắt đầu khám phá.</p>}<ol>@for(int i=0;i<ranked.Count;i++){var item=ranked[i];<li><span class="rank-number">@((i+1).ToString("00"))</span><div><a href="/Story/Details/@item.Book.Id">@item.Book.Title</a><small>@item.Reads lượt đọc</small></div></li>}</ol></div>}
<p class="hint">Theo giờ Việt Nam · Tuần bắt đầu từ thứ Hai.</p></aside>
<section class="book-section rated-section"><h2><svg class="icon gold"><use href="#i-star"/></svg>Truyện được đánh giá cao</h2>@if(Model.TopRated.Count==0){<p class="empty">Chưa có đánh giá. Hãy chia sẻ cảm nhận về truyện bạn đã đọc.</p>}<div class="book-grid home-grid">@foreach(var b in Model.TopRated){<div><partial name="_StoryCardPartial" model="b"/><p class="hint">@b.Ratings.Count người đánh giá</p></div>}</div></section>
<section class="genres-section"><h2>Khám phá theo thể loại</h2><div class="chips">@foreach(string g in Model.Genres){<a class="chip" asp-action="Catalog" asp-route-genre="@g">@g</a>}</div></section>
<section class="book-section newest-section"><div class="section-heading"><h2><svg class="icon gold"><use href="#i-star"/></svg>Mới xuất bản</h2><a href="/Home/Catalog">Xem thư viện <span aria-hidden="true">→</span></a></div><div class="book-grid home-grid">@foreach(var b in Model.Newest){<partial name="_StoryCardPartial" model="b"/>}</div></section></div>
