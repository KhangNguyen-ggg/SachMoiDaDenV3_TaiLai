@model RegisterInput
@{ViewData["Title"]="Đăng ký";}
<div class="container page auth-page"><h1>Gặp nhau qua trang sách.</h1><p class="muted">Tạo tài khoản thành viên để lưu sách và thảo luận.</p><form asp-action="Register" method="post" class="stack"><div asp-validation-summary="All" class="validation"></div><label asp-for="Name">Tên hiển thị</label><input asp-for="Name" autocomplete="nickname"/><label asp-for="Email">Email</label><input asp-for="Email" autocomplete="email"/><label asp-for="Password">Mật khẩu (ít nhất 8 ký tự)</label><input asp-for="Password" autocomplete="new-password" minlength="8"/><label asp-for="ConfirmPassword">Nhập lại mật khẩu</label><input asp-for="ConfirmPassword" autocomplete="new-password"/><button class="button primary">Tạo tài khoản</button></form><p>Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p><p class="hint">Bản dùng thử chưa kết nối cơ sở dữ liệu. Tài khoản vừa tạo sẽ mất khi ứng dụng khởi động lại.</p></div>
